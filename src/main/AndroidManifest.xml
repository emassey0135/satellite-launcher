<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A launcher lists every app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".CommunityLauncherApp"
        android:label="Community Launcher"
        android:allowBackup="false">
        <!-- The launcher speaks for itself via Orbit's screen reader, so Backtalk steps aside and Orbit's hook
             routes the keypad to it (this launcher is no longer com.orbit.-prefixed, so it relies on that hook). -->
        <meta-data android:name="orbit.self_voicing" android:value="true" />

        <activity
            android:name=".PowerDialogActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|keyboardHidden|screenSize|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".GuideProvider"
            android:authorities="dev.emassey0135.communitylauncher.guide"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Not exported: the computer starts it with root. -->
        <service android:name=".SetupService" android:exported="false" />

        <!-- Serves only the public step aside script, which setup opens with Backtalk through root. -->
        <provider
            android:name=".ScriptProvider"
            android:authorities="dev.emassey0135.communitylauncher.scripts"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
